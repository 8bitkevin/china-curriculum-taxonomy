{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8bitkevin/china-curriculum-taxonomy/schema/dependencies.schema.json",
  "title": "中国课程知识图谱 — 先修依赖",
  "type": "object",
  "required": ["schemaVersion", "version", "edgeCount", "dependencies"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "edgeCount": { "type": "integer", "minimum": 0 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "prerequisiteId", "strength"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^ct_" },
          "prerequisiteId": { "type": "string", "pattern": "^ct_" },
          "strength": { "type": "string", "enum": ["hard", "soft"] },
          "reason": { "type": ["string", "null"], "description": "一句话说明为什么需要先学" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
