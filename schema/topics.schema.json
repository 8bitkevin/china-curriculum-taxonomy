{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/8bitkevin/china-curriculum-taxonomy/schema/topics.schema.json",
  "title": "中国课程知识图谱 — 微主题",
  "type": "object",
  "required": ["schemaVersion", "version", "topicCount", "topics"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "topicCount": { "type": "integer", "minimum": 0 },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "type", "subject", "domain", "name", "description",
          "grade", "semester", "ageRangeStart", "ageRangeEnd",
          "evidence", "standards", "textbook"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^ct_" },
          "type": {
            "type": "string",
            "enum": ["CONCEPTUAL", "PROCEDURAL", "REPRESENTATIONAL", "LANGUAGE", "META"],
            "description": "概念性 / 过程性 / 表征性 / 语言性 / 元认知"
          },
          "subject": { "type": "string", "description": "学科，如「数学」「语文」（取值受控于 validate 的学科清单）" },
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "领域（受控维度：按学科一套，见 validate.mjs DOMAIN_BY_SUBJECT；数学为 2022 版课标四大领域）"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "description": "家长能看懂的通俗描述" },
          "grade": { "type": "integer", "minimum": 1, "maximum": 12, "description": "年级：1-6 小学，7-9 初中，10-12 高中" },
          "semester": { "type": "string", "enum": ["上", "下"] },
          "ageRangeStart": { "type": "integer", "minimum": 3, "maximum": 20 },
          "ageRangeEnd": { "type": "integer", "minimum": 3, "maximum": 20 },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "掌握该主题的可观察证据标准"
          },
          "assessmentPrompt": {
            "type": ["string", "null"],
            "description": "自然语言测评问法；{{name}} 为孩子姓名占位符"
          },
          "standards": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+:" },
            "description": "课标条目代码，指向 curriculum-standards.json"
          },
          "textbook": {
            "type": "object",
            "required": ["publisher", "grade", "volume", "unit", "editionYear"],
            "properties": {
              "publisher": { "type": "string", "description": "教材版本，如「人教版」「人教A版」" },
              "book": { "type": "string", "description": "册名（高中五册用，如「必修第一册」；小学/初中省略）" },
              "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
              "volume": { "type": "string", "enum": ["上", "下"] },
              "unit": { "type": ["string", "integer"], "description": "所属单元号或单元名" },
              "editionYear": { "type": "integer", "minimum": 2000, "maximum": 2100, "description": "教材印次/版次年（D-006：按学期跟进新版，跟版时重校对应册）" }
            },
            "additionalProperties": false
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ct_" },
            "description": "冗余便利字段；权威数据在 dependencies.json，两者必须一致"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
